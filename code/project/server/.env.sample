# Copy this file to .env and fill in all values
# NEVER commit .env to version control

# ── Database ─────────────────────────────────────────────────
MONGODB_URL=

# ── Server ───────────────────────────────────────────────────
PORT=5001
CLIENT_URL=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────
# Generate strong random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── AI ───────────────────────────────────────────────────────
# IMPORTANT: If you get 429 quota errors:
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Create API key in new project" (NOT existing project)
# 3. This creates a fresh project with new free quota
# 4. Replace GEMINI_API_KEY with the new key
GEMINI_API_KEY=your_new_key_here

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=