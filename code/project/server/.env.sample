# Copy this file to .env and fill in all values
# NEVER commit .env to version control

# ── Database ─────────────────────────────────────────────────
MONGODB_URL=

# ── Server ───────────────────────────────────────────────────
PORT=5001
CLIENT_URL=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────
# Generate strong random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── AI ───────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=